# Backend origin for the Vite dev proxy (no trailing slash).
# Example: https://xxxx.ngrok-free.app or http://127.0.0.1:8000
VITE_API_TARGET=https://your-tunnel.ngrok-free.app

# Dev + ngrok: prefer leaving VITE_API_URL unset so the app calls same-origin /api/v1 and
# Vite proxies to VITE_API_TARGET (proxy adds ngrok-skip-browser-warning without CORS issues).
# If you set VITE_API_URL to an ngrok URL, the browser calls it cross-origin — your API must
# allow Origin http://localhost:5173 (and normal headers); do not rely on custom ngrok headers from the client.

# Dev: URL prefix for RTK Query — must match vite proxy entry. Default /api/v1
# (requests become /api/v1/auth/register, etc., on the backend).
# VITE_API_PATH_PREFIX=/api/v1

# If your backend mounts auth at the host root (/auth/register, not /api/v1/...), use:
# VITE_API_PATH_PREFIX=/api
# VITE_PROXY_STRIP_PREFIX=true

# Browser → API (set CORS on the server). Per APIdocs.md routes live under `/api/v1`:
# use full base including path, OR origin only — client code normalizes origins to `/api/v1`.
# VITE_API_URL=https://your-tunnel.ngrok-free.app/api/v1
